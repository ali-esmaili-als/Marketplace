{
  "ConnectionStrings": {
    "Marketplace": "Server=localhost;Database=Marketplace;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Outbox": {
    "Enabled": false,
    "PollIntervalMilliseconds": 2000,
    "BatchSize": 25,
    "LeaseSeconds": 60,
    "MaxAttempts": 8,
    "Retention": {
      "Enabled": false,
      "IntervalMinutes": 60,
      "ProcessedRetentionDays": 90,
      "BatchSize": 500
    },
    "Health": {
      "PendingAgeMinutes": 15,
      "LeaseGraceMinutes": 2,
      "DeadLetterWarningCount": 1
    }
  }
}
