{
  "ConnectionStrings": {
    "Marketplace": "Server=localhost;Database=Marketplace;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Marketplace",
    "Audience": "Marketplace.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  }
}
